    "deploy": "npm run build && npm run validate && npm run sitemap && npm run push"
  },
  "devDependencies": {
    "jsonld": "^9.0.0",
    "sharp": "^0.34.5",
    "googleapis": "^173.0.0"
  },
  "dependencies": {
    "@playwright/test": "^1.59.1"
  }
}
