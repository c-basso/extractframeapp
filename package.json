{
  "name": "extractframeapp",
  "scripts": {
    "build": "node build/build.js",
    "validate": "node build/validate/index.js",
    "sitemap": "node build/sitemap.js",
    "start": "npx http-server",
    "site:preview": "node build/preview.js",
    "index:now": "node build/indexnow.js",
    "index:google": "node build/gindexnow.js",
    "gsc": "node build/gsc-report.js",
